generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  credits   Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile?
  resumes Resume[]

  codeAnalyses CodeAnalysis[]

  interview Interview[]
  payments  Payment[]
}

model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  skills     String[]
  targetRole String?
  experience String?
  about      String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resume {
  id         String @id @default(cuid())
  resumeName String
  targetRole String

  atsScore   Int
  conclusion String

  skills     Int
  projects   Int
  experience Int
  formatting Int

  strengths    String[]
  improvements String[]

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Complexity {
  LOW
  MEDIUM
  HIGH
}

model CodeAnalysis {
  id String @id @default(cuid())

  title    String?
  language String
  code     String

  summary      String
  overallScore Int

  correctness     Int
  performance     Int
  readability     Int
  maintainability Int
  bestPractices   Int

  linesOfCode Int
  complexity  Complexity

  issues       String[]
  improvements String[]

  optimizedCode String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum InterviewStatus {
  ONGOING
  COMPLETED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Experience {
  FRESHER
  ONE_TO_TWO_YEARS
  SENIOR
}

enum InputMode {
  TEXT
  VOICE
}

model Interview {
  id String @id @default(cuid())

  category   String
  difficulty Difficulty
  experience Experience
  inputMode  InputMode

  totalQuestions Int

  questions Json

  overallScore Int?
  report       Json?

  status InterviewStatus @default(ONGOING)

  createdAt   DateTime @default(now())
  completedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id String @id @default(cuid())

  razorpayOrderId   String  @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  amount   Int
  currency String @default("INR")

  status PaymentStatus @default(PENDING)

  type String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])
}
